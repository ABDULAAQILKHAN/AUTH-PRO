# Environment Variables

# Prisma (Neon DB Serverless)
# The DATABASE_URL is for the pooled connection
DATABASE_URL="postgresql://user:password@hostname/dbname?pgbouncer=true&connect_timeout=15"
# The DIRECT_URL is for the direct connection
DIRECT_URL="postgresql://user:password@hostname/dbname?connect_timeout=15"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="1d"

# S3 (Cloudflare R2)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="https://your-r2-public-url.com"

# SMTP (Nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM='"Auth-Pro" <noreply@example.com>'

# Admin pass (custom mail)
ADMIN_PASS="your-custom-password"

# Application Settings
# Set to true when deploying to a production environment (enables stricter security, caching, etc.)
PRODUCTION=false

# Base URL of the application, used to construct absolute URLs for email templates and redirects
API_URL=http://localhost:3000

# Optional: port the server listens on (defaults to 3000 if unset)
# PORT=3000

# Optional: alternate base URL for frontend links in emails, used only if it differs from API_URL
# FRONTEND_URL=http://localhost:5173